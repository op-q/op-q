---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<BaseLayout
  title={`${title} — Lucas Lifbom`}
  description={description}
  canonicalPath={canonicalPath}
  type="article"
>
  <slot />
</BaseLayout>
